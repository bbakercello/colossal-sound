# Normalise line endings so scenes and scripts do not churn across machines.
* text=auto eol=lf

# Godot text formats are diffable and mergeable line by line.
*.gd text
*.tscn text
*.tres text
*.godot text
*.import text
*.cfg text
*.md text

# Binary, so git must not try to merge or normalise them.
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.scn binary
*.res binary
